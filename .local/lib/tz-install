#!/bin/sh
# Installs the time zone picker's root helper (tz-root, to /usr/local/lib) and a sudo rule so it needs no password.
# Once, and again after changing tz-root: sudo sh ~/.local/lib/tz-install
set -e
[ "$(id -u)" = 0 ] && [ -n "${SUDO_USER:-}" ] || { echo "Run it with sudo: sudo sh ~/.local/lib/tz-install" >&2; exit 1; }
home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
install -D -o root -g root -m 755 "$home/.local/lib/tz-root" /usr/local/lib/tz-root
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
printf '%s ALL=(root) NOPASSWD: /usr/local/lib/tz-root\n' "$SUDO_USER" > "$tmp"
visudo -cqf "$tmp"
install -o root -g root -m 440 "$tmp" /etc/sudoers.d/timezone
