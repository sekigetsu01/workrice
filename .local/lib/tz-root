#!/bin/sh
# Sets the system time zone: the time zone picker (Super+F3) runs it as root, through /etc/sudoers.d/timezone
PATH=/usr/bin
z=${1:-}
case $z in '' | /* | *..* | posix/* | right/* | *[!A-Za-z0-9_+/-]*) z= ;; esac
[ $# = 1 ] && [ -n "$z" ] && [ -f "/usr/share/zoneinfo/$z" ] || { echo "not a time zone: ${1:-}" >&2; exit 2; }
timedatectl set-timezone "$z" 2>/dev/null || ln -sf "/usr/share/zoneinfo/$z" /etc/localtime
