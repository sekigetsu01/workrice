#   sioyek = see-oh-yek
#   Hermione = her-my-oh-nee
#   Nietzsche = nee-cha
#   lead pipe = led pipe
#
# For exact sounds, put misaki's sound symbols between slashes:  Quickshell = /kwˈɪkʃɛl/

