# sioyek, the PDF and book viewer: the wallpaper's colours, search, the status bar, and the commands its keys run
# (scripts/ and dark.js; keys_user.config binds them)
source                          ~/.cache/wal/sioyek-colors.conf
new_command _fileopen           sh -c exec\ ~/.config/sioyek/scripts/sioyek-pick\ "$@" _ %{window_id}

startup_commands                toggle_custom_color;_labels
super_fast_search               1
case_sensitive_search           0

move_screen_ratio               0.85
wheel_zoom_on_cursor            1

show_document_name_in_statusbar 1
show_closest_bookmark_in_statusbar 1
page_separator_width            0
collapsed_toc                   1

ruler_mode                      1
ruler_padding                   5.0
ruler_x_padding                 5.0
visual_mark_next_page_fraction  0.5
ruler_display_mode              underline

search_url_g https://www.google.com/search?q=
search_url_s https://www.startpage.com/sp/search?query=
search_url_d https://duckduckgo.com/?q=

always_copy_selected_text 1

new_command _note sh -c exec\ ~/.config/sioyek/scripts/sioyek-note\ "$@" _ %{file_path} %{selected_text}
keyboard_select_font_size 16
tag_font_face monospace
new_js_command _custom_mode dark.js::custom
new_js_command _labels dark.js::labels
new_command _speak sh -c exec\ ~/.local/bin/speak\ --add\ "$@" _ %{file_path}
new_command _bookset_link sh -c exec\ ~/.local/bin/bookset\ link\ book\ "$@" _ %{file_path}
new_command _define sh -c exec\ ~/.config/sioyek/scripts/sioyek-define\ "$@" _ %{selected_text}
new_command _figure_save sh -c exec\ ~/.config/sioyek/scripts/sioyek-figure\ "$@" _ %{file_path} %{mouse_pos_document}
new_macro _figure copy_screenshot_to_clipboard;_figure_save
new_macro _ctrl_j [m]control_menu(down);[M]move_visual_mark_down
new_macro _ctrl_k [m]control_menu(up);[M]move_visual_mark_up
new_command _nothing true
