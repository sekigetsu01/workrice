# sioyek's keys, on top of its own: Vim-style moving, o opens a book with yazi, i colours, ; define, Enter note, Y figure
move_down                   j
move_up                     k
move_right                  h
move_left                   l
screen_down                 <space>
screen_up                   <S-<space>>
goto_page_with_page_number  p

prev_state                  <C-t>
next_state                  <C-T>

zoom_in                     K
zoom_out                    J
fit_to_page_width           S
fit_to_page_width_smart     w
_custom_mode         i
toggle_statusbar            <C-n>
toggle_two_page_mode        <C-d>
toggle_fullscreen           <A-f>
reload_no_flicker           <C-r>
_nothing                    q

_fileopen                   o
open_prev_doc               O
open_link                   f
search                      /
command                     :

keyboard_smart_jump         <C-f>
keyboard_overview           F
goto_definition             <C-b>

copy                        <A-c>
add_highlight               H
goto_highlight              gh
delete_highlight            dh

add_bookmark                b
goto_bookmark               gb
delete_bookmark             db
set_mark                    m
goto_mark                   gm

portal                      P
goto_portal                 gp
delete_portal               dp

enter_visual_mark_mode      V
_ctrl_j                     <C-j>
_ctrl_k                     <C-k>


noop <f8>
_define ;
_speak cs
_note <return>
_bookset_link <A-l>
[r]move_visual_mark_down j
[r]move_visual_mark_up k
_figure Y
