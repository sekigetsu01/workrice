#!/bin/sh
# sioyek's o: pick a book with yazi (from ~/Library) and open it in this sioyek window
f=$(mktemp) || exit 1
trap 'rm -f "$f"' EXIT
dir=$HOME/Library
[ -d "$dir" ] || dir=$HOME
flag=${XDG_RUNTIME_DIR:-/tmp}/bookset/pick-set
rm -f "$flag"
YAZI_PICKER=1 kitty yazi --chooser-file="$f" "$dir"
IFS= read -r pick < "$f" || [ -n "$pick" ] || exit 0
case $1 in
    '' | *[!0-9]*) set -- ;;
    *) set -- --window-id "$1" ;;
esac
sioyek "$@" "$pick"
if [ -e "$flag" ]; then
    rm -f "$flag"
    exec "$HOME/.local/bin/bookset" open book "$pick" --ask --this-window
fi
