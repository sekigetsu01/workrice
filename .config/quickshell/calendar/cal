CACHE = os.environ.get("CAL_CACHE") or os.path.join(xdg("XDG_CACHE_HOME", ".cache"), "calendar")
UTC = timezone.utc
FREQS = ("DAILY", "WEEKLY", "MONTHLY", "YEARLY")
WD = {"MO": 0, "TU": 1, "WE": 2, "TH": 3, "FR": 4, "SA": 5, "SU": 6}
DAYS = ("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday")
MONTHS = ("January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December")
WIN = {
    "GMT Standard Time": "Europe/London", "Greenwich Standard Time": "Atlantic/Reykjavik",
    "W. Europe Standard Time": "Europe/Berlin", "Romance Standard Time": "Europe/Paris",
    "Central Europe Standard Time": "Europe/Budapest", "Central European Standard Time": "Europe/Warsaw",
    "E. Europe Standard Time": "Europe/Chisinau", "FLE Standard Time": "Europe/Kyiv", "GTB Standard Time": "Europe/Bucharest",
    "Eastern Standard Time": "America/New_York", "Central Standard Time": "America/Chicago",
    "Mountain Standard Time": "America/Denver", "Pacific Standard Time": "America/Los_Angeles",
    "India Standard Time": "Asia/Kolkata", "China Standard Time": "Asia/Shanghai", "Tokyo Standard Time": "Asia/Tokyo",
    "AUS Eastern Standard Time": "Australia/Sydney", "UTC": "UTC", "Coordinated Universal Time": "UTC",
}
DUR = re.compile(r"P(?:(\d+)W)?(?:(\d+)D)?(?:T(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?)?$")


def die(msg, code=1):
    sys.stderr.write(msg + "\n")
    sys.exit(code)


def unfold(text):
    out = []
    for line in text.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        if line[:1] in (" ", "\t") and out:
            out[-1] += line[1:]
        elif line.strip():
            out.append(line)
    return out


def split_quoted(s, sep):
    if '"' not in s:
        return s.split(sep)
    out, cur, q = [], [], False
    for c in s:
        if c == '"':
            q = not q
        if c == sep and not q:
            out.append("".join(cur))
            cur = []
        else:
            cur.append(c)
    out.append("".join(cur))
    return out


def split_line(line):
    if '"' in line:
        i, q = -1, False
        for n, c in enumerate(line):
            if c == '"':
                q = not q
            elif c == ":" and not q:
                i = n
                break
    else:
        i = line.find(":")
    if i < 0:
        return line.upper(), {}, ""
    parts = split_quoted(line[:i], ";")
    params = {}
    for p in parts[1:]:
        k, _, v = p.partition("=")
        params[k.strip().upper()] = v.strip('"')
    return parts[0].strip().upper(), params, line[i + 1:]


def prop_name(line):
    m = len(line)
    for c in ";:":
        i = line.find(c)
        if 0 <= i < m:
            m = i
    return line[:m].strip().upper()


def tree(lines):
    root = ["", [], []]
    stack = [root]
    for line in lines:
        head = line[:6].upper()
        if head == "BEGIN:":
            c = [line[6:].strip().upper(), [], []]
            stack[-1][2].append(c)
            stack.append(c)
        elif head[:4] == "END:":
            if len(stack) > 1:
                stack.pop()
        else:
            stack[-1][1].append(line)
    return root


def props(comp):
    d = {}
    for line in comp[1]:
        n, p, v = split_line(line)
        d.setdefault(n, []).append((p, v))
    return d


def unesc(v):
    if "\\" not in v:
        return v
    out, i, n = [], 0, len(v)
    while i < n:
        c = v[i]
        if c == "\\" and i + 1 < n:
            nx = v[i + 1]
            out.append("\n" if nx in "nN" else nx)
            i += 2
        else:
            out.append(c)
            i += 1
    return "".join(out)


def esc(v):
    return v.replace("\\", "\\\\").replace(";", "\\;").replace(",", "\\,").replace("\r\n", "\n").replace("\n", "\\n")


_tzc = {}


def get_tz(tzid, vtz):
    if tzid in _tzc:
        return _tzc[tzid]
    from zoneinfo import ZoneInfo
    tz = None
    parts = tzid.strip().split("/")
    for c in [tzid.strip(), WIN.get(tzid.strip())] + ["/".join(parts[-k:]) for k in (3, 2, 1) if len(parts) > k]:
        if not c:
            continue
        try:
            tz = ZoneInfo(c)
            break
        except Exception:
            pass
    if tz is None:
        tz = vtz.get(tzid)
    _tzc[tzid] = tz
    return tz


def offset(v):
    v = v.strip()
    sign = -1 if v[:1] == "-" else 1
    v = v.lstrip("+-")
    return timezone(sign * timedelta(hours=int(v[:2]), minutes=int(v[2:4] or 0)))


def parse_dt(value, params, tzf):
    v = value.strip()
    if params.get("VALUE", "").upper() == "DATE" or (len(v) == 8 and v.isdigit()):
        return date(int(v[:4]), int(v[4:6]), int(v[6:8]))
    dt = datetime(int(v[:4]), int(v[4:6]), int(v[6:8]), int(v[9:11]), int(v[11:13]), min(59, int(v[13:15] or 0)))
    if v[-1:] in "zZ":
        return dt.replace(tzinfo=UTC)
    tzid = params.get("TZID")
    if tzid and tzf:
        tz = tzf(tzid)
        if tz:
            return dt.replace(tzinfo=tz)
    return dt


def parse_dur(v):
    v = v.strip()
    sign = -1 if v[:1] == "-" else 1
    m = DUR.match(v.lstrip("+-"))
    if not m:
        raise ValueError(v)
    w, d, h, mi, s = (int(x or 0) for x in m.groups())
    return sign * timedelta(weeks=w, days=d, hours=h, minutes=mi, seconds=s)


def isdt(v):
    return isinstance(v, datetime)


def loc(v):
    if isdt(v) and v.tzinfo:
        return v.astimezone().replace(tzinfo=None)
    return v


def as_dt(v):
    return v if isdt(v) else datetime.combine(v, time())


def epoch(v):
    return as_dt(loc(v)).timestamp()


def iso(v):
    return v.isoformat("T", "minutes") if isdt(v) else v.isoformat()


def parse_rrule(v, tzf):
    r = {}
    for part in v.split(";"):
        k, _, val = part.partition("=")
        r[k.strip().upper()] = val.strip()
    freq = r.get("FREQ", "").upper()
    if freq not in FREQS:
        return None
    byday = []
    for x in filter(None, r.get("BYDAY", "").upper().split(",")):
        x = x.strip()
        if x[-2:] in WD:
            n = x[:-2]
            byday.append((int(n) if n not in ("", "+", "-") else 0, WD[x[-2:]]))

    def ints(k):
        return [int(x) for x in r.get(k, "").split(",") if x.strip().lstrip("+-").isdigit()]
    return {
        "freq": freq, "interval": max(1, int(r.get("INTERVAL") or 1)),
        "count": int(r["COUNT"]) if r.get("COUNT", "").isdigit() else None,
        "until": parse_dt(r["UNTIL"], {}, None) if r.get("UNTIL") else None,
        "byday": byday, "bymonthday": [x for x in ints("BYMONTHDAY") if x], "bymonth": [x for x in ints("BYMONTH") if 1 <= x <= 12],
        "bysetpos": [x for x in ints("BYSETPOS") if x], "wkst": WD.get(r.get("WKST", "MO").upper(), 0),
        "simple": set(r) <= {"FREQ", "INTERVAL", "WKST"} and int(r.get("INTERVAL") or 1) == 1,
    }


def mdays(y, m):
    return (date(y + m // 12, m % 12 + 1, 1) - date(y, m, 1)).days


def nth_pick(hits, nth):
    if nth > 0 and nth <= len(hits):
        return [hits[nth - 1]]
    if nth < 0 and -nth <= len(hits):
        return [hits[nth]]
    return []


def month_cands(y, m, rule, d0):
    n = mdays(y, m)
    days = None
    if rule["bymonthday"]:
        days = {x if x > 0 else n + x + 1 for x in rule["bymonthday"]}
        days = {x for x in days if 1 <= x <= n}
    if rule["byday"]:
        first = date(y, m, 1).weekday()
        hits = set()
        for nth, wd in rule["byday"]:
            every = list(range(1 + (wd - first) % 7, n + 1, 7))
            hits.update(every if nth == 0 else nth_pick(every, nth))
        days = hits if days is None else hits & days
    if days is None:
        days = {d0} if d0 <= n else set()
    return [date(y, m, d) for d in sorted(days)]


def period(rule, d0, k):
    f, iv = rule["freq"], rule["interval"]
    bymonth = rule["bymonth"]
    if f == "DAILY":
        d = d0 + timedelta(days=k * iv)
        ok = (not bymonth or d.month in bymonth) and (not rule["byday"] or d.weekday() in {w for _, w in rule["byday"]})
        if ok and rule["bymonthday"]:
            n = mdays(d.year, d.month)
            ok = d.day in {x if x > 0 else n + x + 1 for x in rule["bymonthday"]}
        return d, [d] if ok else []
    if f == "WEEKLY":
        ws = d0 - timedelta(days=(d0.weekday() - rule["wkst"]) % 7) + timedelta(days=7 * iv * k)
        wds = {w for _, w in rule["byday"]} or {d0.weekday()}
        c = sorted(ws + timedelta(days=(w - rule["wkst"]) % 7) for w in wds)
        return ws, [d for d in c if not bymonth or d.month in bymonth]
    if f == "MONTHLY":
        t = d0.month - 1 + k * iv
        y, m = d0.year + t // 12, t % 12 + 1
        return date(y, m, 1), [] if bymonth and m not in bymonth else month_cands(y, m, rule, d0.day)
    y = d0.year + k * iv
    if rule["byday"] and not bymonth and not rule["bymonthday"]:
        hits = set()
        n = (date(y + 1, 1, 1) - date(y, 1, 1)).days
        first = date(y, 1, 1).weekday()
        for nth, wd in rule["byday"]:
            every = [date(y, 1, 1) + timedelta(days=x) for x in range((wd - first) % 7, n, 7)]
            hits.update(every if nth == 0 else nth_pick(every, nth))
        return date(y, 1, 1), sorted(hits)
    c = []
    for m in sorted(bymonth) or [d0.month]:
        if rule["byday"] or rule["bymonthday"]:
            c += month_cands(y, m, rule, d0.day)
        elif d0.day <= mdays(y, m):
            c.append(date(y, m, d0.day))
    return date(y, 1, 1), c


def skip(rule, d0, lo):
    if rule["count"] is not None or lo <= d0:
        return 0
    f, iv = rule["freq"], rule["interval"]
    if f == "DAILY":
        k = (lo - d0).days // iv
    elif f == "WEEKLY":
        k = (lo - d0).days // (7 * iv)
    elif f == "MONTHLY":
        k = ((lo.year - d0.year) * 12 + lo.month - d0.month) // iv
    else:
        k = (lo.year - d0.year) // iv
    return max(0, k - 1)


def expand(start, rule, lo, hi, until):
    dt = isdt(start)
    d0 = start.date() if dt else start
    t0 = start.time() if dt else None
    count = rule["count"]
    if until is None or start <= until:
        yield start
    n = 1
    hid = hi.date() if dt else hi
    k = skip(rule, d0, lo.date() if dt else lo)
    for k in range(k, k + 200000):
        pstart, cands = period(rule, d0, k)
        if pstart > hid:
            return
        if rule["bysetpos"]:
            cands = sorted({c for p in rule["bysetpos"] for c in nth_pick(cands, p)})
        for c in cands:
            v = datetime.combine(c, t0) if dt else c
            if v <= start:
                continue
            if (until is not None and v > until) or (count is not None and n >= count):
                return
            if v > hi:
                return
            n += 1
            yield v


def wall_until(u, start, tz):
    if u is None:
        return None
    if isdt(start):
        if not isdt(u):
            return datetime.combine(u, time(23, 59, 59))
        if u.tzinfo:
            return u.astimezone(tz).replace(tzinfo=None) if tz else loc(u)
        return u
    return loc(u).date() if isdt(u) else u


def occurrences(ev, lo, hi, ovr):
    s, dur = ev["s"], ev["dur"]
    rule = ev["rule"]
    if rule is None and not ev["rd"]:
        a, b = ev["span"]
        if b > lo and a < hi or (a == b and lo <= a < hi):
            L = loc(s)
            return [(L, L + dur)]
        return []
    if rule is None:
        cands = [s] + ev["rd"]
    else:
        tz = s.tzinfo if isdt(s) else None
        ws = s.replace(tzinfo=None) if tz else s
        slack = timedelta(days=2)
        if isdt(ws):
            wlo, whi = lo - dur - slack, hi + slack
        else:
            wlo, whi = (lo - dur - slack).date(), (hi + slack).date()
        cands = []
        for w in expand(ws, rule, wlo, whi, wall_until(rule["until"], ws, tz)):
            if w >= wlo:
                cands.append(w.replace(tzinfo=tz) if tz else w)
        cands += ev["rd"]
    skipset = ovr.get(ev["uid"], ()) if rule is not None or ev["rd"] else ()
    out = []
    for c in cands:
        L = loc(c)
        if L in ev["ex"] or (isdt(L) and L.date() in ev["ex"]):
            continue
        if skipset and (L in skipset or (isdt(L) and L.date() in skipset)):
            continue
        E = L + dur
        if as_dt(E) > lo and as_dt(L) < hi or (dur == timedelta(0) and lo <= as_dt(L) < hi):
            out.append((L, E))
    return out


def comp_events(comp, tzf):
    p = props(comp)

    def one(k):
        v = p.get(k)
        return v[0] if v else ({}, "")

    sp, sv = one("DTSTART")
    if not sv:
        return None
    s = parse_dt(sv, sp, tzf)
    ep, evv = one("DTEND")
    if evv:
        e = parse_dt(evv, ep, tzf)
    elif p.get("DURATION"):
        e = s + parse_dur(one("DURATION")[1])
    else:
        e = s + timedelta(days=1) if not isdt(s) else s
    if isdt(s) and not isdt(e):
        e = as_dt(e)
    if not isdt(s) and isdt(e):
        e = loc(e).date()
    dur = loc(e) - loc(s)
    if dur < timedelta(0) or (not isdt(s) and dur < timedelta(days=1)):
        dur = timedelta(days=1) if not isdt(s) else timedelta(0)
    rr = one("RRULE")[1]
    rule = parse_rrule(rr, tzf) if rr else None
    ex = set()
    for xp, xv in p.get("EXDATE", ()):
        for x in xv.split(","):
            if x.strip():
                ex.add(loc(parse_dt(x, xp, tzf)))
    rd = []
    for xp, xv in p.get("RDATE", ()):
        if xp.get("VALUE", "").upper() != "PERIOD":
            for x in xv.split(","):
                if x.strip():
                    rd.append(parse_dt(x, xp, tzf))
    rp, rv = one("RECURRENCE-ID")
    alarms = []
    for sub in comp[2]:
        if sub[0] != "VALARM":
            continue
        tp, tv = one_of(props(sub), "TRIGGER")
        if not tv:
            continue
        try:
            if tp.get("VALUE", "").upper() == "DATE-TIME":
                alarms.append(("a", epoch(parse_dt(tv, tp, tzf)), False))
            else:
                alarms.append(("r", -int(parse_dur(tv).total_seconds()), tp.get("RELATED", "").upper() == "END"))
        except ValueError:
            pass
    return {
        "uid": one("UID")[1].strip(), "title": unesc(one("SUMMARY")[1]), "note": unesc(one("DESCRIPTION")[1]),
        "loc": unesc(one("LOCATION")[1]), "s": s, "dur": dur, "rule": rule, "rrule": rr, "ex": ex, "rd": rd,
        "rid": loc(parse_dt(rv, rp, tzf)) if rv else None, "cancelled": one("STATUS")[1].strip().upper() == "CANCELLED",
        "alarms": alarms,
    }


def one_of(p, k):
    v = p.get(k)
    return v[0] if v else ({}, "")


def calendars(root):
    return [c for c in root[2] if c[0] == "VCALENDAR"] or [root]


def parse_text(text):
    root = tree(unfold(text))
    events, ovr = [], {}
    for cal in calendars(root):
        vtz = {}
        for c in cal[2]:
            if c[0] == "VTIMEZONE":
                tid = one_of(props(c), "TZID")[1].strip()
                for sub in c[2]:
                    if sub[0] == "STANDARD":
                        try:
                            vtz[tid] = offset(one_of(props(sub), "TZOFFSETTO")[1])
                        except ValueError:
                            pass

        def tzf(tzid, vtz=vtz):
            return get_tz(tzid, vtz)
        for c in cal[2]:
            if c[0] == "VEVENT":
                try:
                    ev = comp_events(c, tzf)
                except (ValueError, IndexError):
                    ev = None
                if ev:
                    L = loc(ev["s"])
                    ev["span"] = (as_dt(L), as_dt(L + ev["dur"]))
                    events.append(ev)
                    if ev["rid"] is not None:
                        ovr.setdefault(ev["uid"], set()).add(ev["rid"])
    return events, ovr


def read_text(path):
    with open(path, "rb") as f:
        return f.read().decode("utf-8", "replace")


def atomic_write(path, data):
    d = os.path.dirname(path) or "."
    os.makedirs(d, exist_ok=True)
    tmp = os.path.join(d, ".%s.tmp%d" % (os.path.basename(path), os.getpid()))
    try:
        with open(tmp, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


class Store:
    def __init__(self):
        self.path = os.path.join(CACHE, "parsed.pickle")
        self.dirty = False
        try:
            zone = os.environ.get("TZ", "") + "|" + os.path.realpath("/etc/localtime")
        except OSError:
            zone = os.environ.get("TZ", "")
        self.zone = (zone, 3)
        try:
            with open(self.path, "rb") as f:
                self.cache = pickle.load(f)
            if not isinstance(self.cache, dict) or self.cache.get("") != self.zone:
                self.cache = {}
        except Exception:
            self.cache = {}

    def load(self, path):
        try:
            st = os.stat(path)
        except OSError:
            return [], {}
        sig = (st.st_mtime_ns, st.st_size, st.st_ino)
        hit = self.cache.get(path)
        if hit and hit[0] == sig:
            return hit[1]
        data = parse_text(read_text(path))
        self.cache[path] = (sig, data)
        self.dirty = True
        return data

    def save(self):
        if self.dirty:
            keep = {p: v for p, v in self.cache.items() if p and os.path.exists(p)}
            keep[""] = self.zone
            try:
                atomic_write(self.path, pickle.dumps(keep, pickle.HIGHEST_PROTOCOL))
            except OSError:
                pass


def feed_urls():
    try:
        lines = read_text(FEEDS).splitlines()
    except OSError:
        return []
    out = []
    for line in lines:
        u = line.strip()
        if not u or u.startswith("#"):
            continue
        if u.lower().startswith("webcal://"):
            u = "https://" + u[9:]
        if u not in out:
            out.append(u)
    return out


def feed_path(url):
    import hashlib
    return os.path.join(CACHE, "feed-%s.ics" % hashlib.sha1(url.encode()).hexdigest()[:16])


def sources():
    out = [(0, ICS)]
    for i, u in enumerate(feed_urls()):
        out.append((i + 1, feed_path(u)))
    return out


def all_events(store):
    for src, path in sources():
        events, ovr = store.load(path)
        for ev in events:
            if not ev["cancelled"]:
                yield src, ev, ovr


def rep_of(ev):
    r = ev["rule"]
    if r is None:
        return "custom" if ev["rd"] else "none"
    return r["freq"].lower() if r["simple"] else "custom"


def alarm_of(ev):
    a = ev["alarms"]
    if len(a) == 1 and a[0][0] == "r" and not a[0][2] and a[0][1] % 60 == 0:
        return a[0][1] // 60
    return None if not a else "other"


def event_base(src, ev):
    s = loc(ev["s"])
    dt = isdt(s)
    return {
        "uid": ev["uid"], "src": src, "ro": src != 0, "title": ev["title"], "note": ev["note"], "loc": ev["loc"],
        "allday": not dt, "rid": iso(ev["rid"]) if ev["rid"] is not None else "", "rep": rep_of(ev), "rule": ev["rrule"],
        "alarm": alarm_of(ev), "d0": iso(s.date() if dt else s), "t0": s.strftime("%H:%M") if dt else "",
        "t1": (s + ev["dur"]).strftime("%H:%M") if dt else "", "days": 0 if dt else ev["dur"].days,
    }


def sort_key(o):
    return (o["s"][:10], 0 if o["allday"] else 1, 1 if o.get("routine") else 0, o.get("order", (0, 0)), o["s"], o["title"].lower())


ROUTINES = os.path.join(os.path.dirname(ICS), "routines.md")
WEEKDAYS = ("monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday")


def day_row(t):
    if ":" not in t:
        return None
    label, rest = t.split(":", 1)
    w = label.strip().lower()
    day = WEEKDAYS.index(w) if w in WEEKDAYS else rem_weekday(w)
    if day is None:
        return None
    return day, [x.strip() for x in rest.split(",") if x.strip()]


def read_routines():
    try:
        with open(ROUTINES, encoding="utf-8") as f:
            lines = f.read().splitlines()
        base = datetime.fromtimestamp(os.path.getmtime(ROUTINES))
    except OSError:
        return {}, [], []
    found, appts, bad = {}, [], []
    for i, kind, rest in plan_walk(lines):
        n, t = i + 1, lines[i].strip()
        if kind in ("head", "td", "item"):
            continue
        if kind == "appt":
            a = appt_row(rest, base.date())
            if a and a[1]:
                appts.append((n, a[0], a[1]))
            else:
