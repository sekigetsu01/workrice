def ics_value(v, style):
    if not isdt(v):
        return ";VALUE=DATE", v.strftime("%Y%m%d")
    if style and style[0] == "Z":
        return "", v.astimezone(UTC).strftime("%Y%m%dT%H%M%SZ")
    if style and style[0] == "TZ":
        tid = style[1]
        q = '"%s"' % tid if any(c in tid for c in ':;,') else tid
        return ";TZID=" + q, v.astimezone(style[2]).strftime("%Y%m%dT%H%M%S")
    return "", v.strftime("%Y%m%dT%H%M%S")


def trigger(m):
    if m == 0:
        return "PT0S"
    sign, m = ("-", m) if m > 0 else ("", -m)
    if m % 1440 == 0:
        return "%sP%dD" % (sign, m // 1440)
    if m % 60 == 0:
        return "%sPT%dH" % (sign, m // 60)
    return "%sPT%dM" % (sign, m)


def valarm(m, title):
