def fix_until(rr, allday, style):
    m = re.search(r"(?i)UNTIL=([0-9TZ]+)", rr)
    if not m:
        return rr
    try:
        u = loc(parse_dt(m.group(1), {}, None))
    except ValueError:
        return rr
    if allday:
        v = (u.date() if isdt(u) else u).strftime("%Y%m%d")
    else:
        u = u if isdt(u) else datetime.combine(u, time(23, 59, 59))
        v = u.astimezone(UTC).strftime("%Y%m%dT%H%M%SZ") if style else u.strftime("%Y%m%dT%H%M%S")
    return rr[:m.start(1)] + v + rr[m.end(1):]


def hm(s):
    m = re.fullmatch(r"(\d{1,2}):(\d{2})", s or "")
    if not m or int(m.group(1)) > 23 or int(m.group(2)) > 59:
        return None
    return time(int(m.group(1)), int(m.group(2)))


