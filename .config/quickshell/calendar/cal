PLAN_PREFIX = re.compile(r"^\s*(?:[-*+]\s+)?(td|todo|to-do)\s*:\s*", re.I)
PLAN_SECTION = re.compile(r"^(agenda|routines?|to-?\s?dos?)\s*:?$", re.I)
PLAN_SECTIONS = {"a": "appt", "r": "day", "t": "item"}


def appt_row(t, today):
    m = re.fullmatch(r"(\d{1,2})/(\d{1,2})(?:/(\d{2}|\d{4}))?\s*:\s*(.+)", t)
    if not m:
        return None
    d, mo, y = int(m.group(1)), int(m.group(2)), m.group(3)
    try:
        if y:
            day = date(int(y) + (2000 if len(y) == 2 else 0), mo, d)
        else:
            day = date(today.year, mo, d)
            if day < today:
                day = date(today.year + 1, mo, d)
    except ValueError:
        return None
    return day, m.group(4).strip()


def plan_walk(lines):
    sec = None
    for i, line in enumerate(lines):
        t = line.strip()
        if not t or t.startswith("#"):
            continue
        m = PLAN_SECTION.match(t)
        if m:
            sec = PLAN_SECTIONS[m.group(1)[0].lower()]
            yield i, "head", ""
            continue
        kind, rest = plan_kind(t)
        if kind:
            yield i, kind, rest
        elif sec == "item":
            yield i, "item", re.sub(r"^[-*+]\s+", "", t)
        else:
            yield i, sec, t


def plan_kind(line):
    m = PLAN_PREFIX.match(line)
    if not m:
        return None, line.strip()
    return "td", line[m.end():].strip()


def plan_tidy(text, today):
    lines = text.split("\n")
    drop, new = set(), {}
    for i, kind, rest in plan_walk(lines):
        if kind == "appt":
            r = appt_row(rest, today)
            if r:
                if r[0] < today:
                    drop.add(i)
                else:
                    new[i] = "%s: %s" % (r[0].strftime("%d/%m/%y"), r[1])
    return "\n".join(new.get(i, l) for i, l in enumerate(lines) if i not in drop)


def plan_read(now=None):
    try:
        with open(ROUTINES, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return "", []
    today = (now or datetime.now()).date()
    new = plan_tidy(text, today)
    if new != text:
        atomic_write(ROUTINES, new.encode("utf-8"))
    tasks = []
    for i, kind, rest in plan_walk(new.split("\n")):
        if kind == "td":
            tasks += [(i,) + done_split(t) for t in rest.split(",") if t.strip()]
        elif kind == "item":
            tasks.append((i,) + done_split(rest))
    return new, tasks


DONE_MARK = re.compile(r"\s*\[x\]\s*$", re.I)


def done_split(t):
    t = t.strip()
    m = DONE_MARK.search(t)
    return (t[:m.start()].strip(), True) if m else (t, False)


def done_join(t, done):
    return t + " [x]" if done else t


