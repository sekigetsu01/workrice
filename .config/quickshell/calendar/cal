def day_word(d, ref):
    n = (d - ref).days
    if n == 0:
        return "Today"
    if n == 1:
        return "Tomorrow"
    s = "%s %d %s" % (DAYS[d.weekday()], d.day, MONTHS[d.month - 1])
    return s if d.year == ref.year else s + " " + str(d.year)


def alarm_body(L, E, at):
    ref = datetime.fromtimestamp(at).date()
    if not isdt(L):
        last = E - timedelta(days=1)
        w = day_word(L, ref) + ", all day"
        return w if last <= L else w + " until " + day_word(last, ref)
    t = L.strftime("%H:%M")
    if E > L:
        t += "–" + E.strftime("%H:%M")
        if E.date() != L.date():
            t += " " + day_word(E.date(), ref)
    return day_word(L.date(), ref) + " " + t


def next_alarm(store, after):
    base = datetime.fromtimestamp(after)
    evs = [x for x in all_events(store) if x[1]["alarms"]]
    for horizon in (2, 35, 400, 3000):
        limit = after + horizon * 86400
        lo, hi = base - timedelta(days=8), base + timedelta(days=horizon + 8)
        best, items = None, []
        for src, ev, ovr in evs:
            occ = None
            for kind, secs, rel_end in ev["alarms"]:
                if kind == "a":
                    hits = [(secs, None, None)] if after < secs <= limit else []
                else:
                    if occ is None:
                        occ = occurrences(ev, lo, hi, ovr)
                    hits = []
                    for L, E in occ:
                        t = (epoch(E) if rel_end else epoch(L)) - secs
                        if after < t <= limit:
                            hits.append((t, L, E))
                for t, L, E in hits:
                    t = int(t)
                    if best is None or t < best:
                        best, items = t, []
                    if t == best:
                        if L is None:
                            L, E = loc(ev["s"]), loc(ev["s"]) + ev["dur"]
                        items.append({"uid": ev["uid"], "title": ev["title"] or "(no title)", "body": alarm_body(L, E, t)})
        if best is not None:
            seen, uniq = set(), []
            for it in items:
                k = (it["uid"], it["title"], it["body"])
                if k not in seen:
                    seen.add(k)
                    uniq.append(it)
            return {"at": best, "items": uniq}
    return {"at": None, "items": []}


