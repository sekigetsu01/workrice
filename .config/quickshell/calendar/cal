def fill_event(comp, d, raw, is_new):
    title = (d.get("title") or "").strip()
    if not title:
        die("title is empty", 2)
    try:
        day = date.fromisoformat(d.get("date", ""))
    except ValueError:
        die("bad date", 2)
    st = d.get("start") or ""
    style = None if is_new else dt_style(comp, raw)
    old = None
    if not is_new:
        try:
            p = props(comp)
            sp, sv = one_of(p, "DTSTART")
            s0 = parse_dt(sv, sp, raw.tzf)
            ep, ev = one_of(p, "DTEND")
            if ev:
                old = loc(parse_dt(ev, ep, raw.tzf)) - loc(s0)
            elif p.get("DURATION"):
                old = parse_dur(one_of(p, "DURATION")[1])
            old = (old, isdt(s0), s0)
        except (ValueError, IndexError):
            old = None
    if not st:
        s = day
        n = int(d.get("days") or 0)
        if n < 1:
            n = old[0].days if old and not old[1] and old[0] and old[0].days >= 1 else 1
        e = day + timedelta(days=n)
    else:
        t0 = hm(st)
        if t0 is None:
            die("bad start time", 2)
        s = datetime.combine(day, t0)
        en = d.get("end") or ""
        if en:
            t1 = hm(en)
            if t1 is None:
                die("bad end time", 2)
            e = datetime.combine(day, t1)
            if e <= s:
                e += timedelta(days=1)
        else:
            e = s + timedelta(hours=1)
    pa, va = ics_value(s, style)
    pb, vb = ics_value(e, style)
    set_prop(comp, "DTSTART", ["DTSTART" + pa + ":" + va])
    set_prop(comp, "DTEND", ["DTEND" + pb + ":" + vb])
    set_prop(comp, "DURATION", [])
    set_prop(comp, "SUMMARY", ["SUMMARY:" + esc(title)])
    note = (d.get("note") or "").rstrip()
    set_prop(comp, "DESCRIPTION", ["DESCRIPTION:" + esc(note)] if note else [])
    now = utcnow()
    set_prop(comp, "DTSTAMP", ["DTSTAMP:" + now])
    set_prop(comp, "LAST-MODIFIED", ["LAST-MODIFIED:" + now])
    if is_new:
        set_prop(comp, "CREATED", ["CREATED:" + now])
    else:
        q = get_prop(comp, "SEQUENCE")
        n = int(q[2]) + 1 if q and q[2].strip().isdigit() else 1
        set_prop(comp, "SEQUENCE", ["SEQUENCE:%d" % n])
    rep = d.get("repeat", "none")
    override = get_prop(comp, "RECURRENCE-ID") is not None
    if rep != "keep" and not override:
        if rep in ("daily", "weekly", "monthly", "yearly"):
            set_prop(comp, "RRULE", ["RRULE:FREQ=" + rep.upper()])
        else:
            for k in ("RRULE", "RDATE", "EXDATE"):
                set_prop(comp, k, [])
    else:
        q = get_prop(comp, "RRULE")
        if q and old and old[1] != isdt(s):
            set_prop(comp, "RRULE", ["RRULE:" + fix_until(q[2], not isdt(s), style)])
    if not is_new and not override and old:
        move_exceptions(comp, raw, old[2], s, style)
    al = d.get("alarm", "keep")
    if al != "keep":
        comp[2] = [c for c in comp[2] if c[0] != "VALARM"]
        if al is not None:
            comp[2].append(valarm(int(al), title))


def move_exceptions(comp, raw, s0, s, style):
    tz = style[2] if style and style[0] == "TZ" else UTC if style else None

    def wall(v):
        if not isdt(v) or not (tz or v.tzinfo):
            return v
        return v.astimezone(tz).replace(tzinfo=None) if tz else loc(v)

    new, old = wall(s), wall(s0)
    if new == old:
        return
    days = (new.date() if isdt(new) else new) - (old.date() if isdt(old) else old)

    def moved(v):
        d = wall(v)
        d = (d.date() if isdt(d) else d) + days
        if not isdt(new):
            return d
        d = datetime.combine(d, new.time())
        return d.replace(tzinfo=tz) if tz else d

    ex = []
    for xp, xv in props(comp).get("EXDATE", ()):
        for x in xv.split(","):
            try:
                ex.append(moved(parse_dt(x, xp, raw.tzf)))
            except (ValueError, IndexError):
                pass
    set_prop(comp, "EXDATE", ["EXDATE%s:%s" % ics_value(v, style) for v in ex])
    q = get_prop(comp, "RRULE")
    m = re.search(r"(?i)UNTIL=([0-9TZ]+)", q[2]) if q else None
    if m:
        try:
            u = parse_dt(m.group(1), {}, None)
            u = u + (new - old if isdt(new) and isdt(old) and isdt(u) else days)
            fmt = "%Y%m%d" if not isdt(u) else "%Y%m%dT%H%M%SZ" if m.group(1).upper().endswith("Z") else "%Y%m%dT%H%M%S"
            set_prop(comp, "RRULE", ["RRULE:" + q[2][:m.start(1)] + u.strftime(fmt) + q[2][m.end(1):]])
        except (ValueError, TypeError):
            pass
    uid =(get_prop(comp, "UID") or ("", {}, ""))[2].strip()
    for c in raw.find("VEVENT", uid):
        p = get_prop(c, "RECURRENCE-ID")
        if c is not comp and p:
            try:
                set_prop(c, "RECURRENCE-ID", ["RECURRENCE-ID%s:%s" % ics_value(moved(parse_dt(p[2], p[1], raw.tzf)), style)])
            except (ValueError, IndexError):
                pass


def cmd_add(args):
    d = read_input()
    with Raw() as raw:
        uid = new_uid()
        comp = ["VEVENT", ["UID:" + uid], []]
        fill_event(comp, d, raw, True)
        raw.add(comp)
    out({"ok": True, "uid": uid})


def pick(raw, uid, rid):
    for c in raw.find("VEVENT", uid):
        p = get_prop(c, "RECURRENCE-ID")
        if rid:
            if p:
                try:
                    if iso(loc(parse_dt(p[2], p[1], raw.tzf))) == rid:
                        return c
                except ValueError:
                    pass
        elif not p:
            return c
    return None


def cmd_edit(args):
    d = read_input()
    uid = d.get("uid", "")
    with Raw() as raw:
        comp = pick(raw, uid, d.get("rid") or "")
        if comp is None:
            die("no such event", 1)
        fill_event(comp, d, raw, False)
        raw.changed = True
    out({"ok": True, "uid": uid})


def cmd_delete(args):
    d = read_input()
    uid, rid, only = d.get("uid", ""), d.get("rid") or "", d.get("only") or ""
    with Raw() as raw:
        master = pick(raw, uid, "")
        if only and master is not None and (get_prop(master, "RRULE") or get_prop(master, "RDATE")):
            key = rid or only
            if rid:
                target = pick(raw, uid, rid)
                raw.remove("VEVENT", {uid}, lambda c: c is target)
            try:
                v = datetime.strptime(key, "%Y-%m-%dT%H:%M") if "T" in key else date.fromisoformat(key)
            except ValueError:
                die("bad occurrence", 2)
            sp = get_prop(master, "DTSTART")
            if sp and (len(sp[2].strip()) == 8 or sp[1].get("VALUE", "").upper() == "DATE"):
                v = v.date() if isdt(v) else v
            elif not isdt(v):
                v = datetime.combine(v, time())
            pa, va = ics_value(v, dt_style(master, raw))
            master[1].append("EXDATE" + pa + ":" + va)
            set_prop(master, "DTSTAMP", ["DTSTAMP:" + utcnow()])
            raw.changed = True
        elif rid and master is not None:
            raw.remove("VEVENT", {uid}, lambda c: c is not master)
        elif raw.remove("VEVENT", {uid}) == 0:
            die("no such event", 1)
    out({"ok": True})


def state_path():
    return os.path.join(CACHE, "feeds.json")


def read_state():
    try:
        with open(state_path()) as f:
            s = json.load(f)
        return s if isinstance(s, dict) else {}
    except (OSError, ValueError):
        return {}


def feed_errors():
    st = read_state().get("feeds", {})
    return ["%s: %s" % (u, st[u]["err"]) for u in feed_urls() if st.get(u, {}).get("err")]


def fetch_one(url, meta):
    import urllib.request
    import urllib.error
    if not re.match(r"(?i)https?://", url):
        return url, {"err": "not an http(s) URL"}, None
    req = urllib.request.Request(url, headers={"User-Agent": "cal/1", "Accept": "text/calendar, */*"})
    if meta.get("etag"):
        req.add_header("If-None-Match", meta["etag"])
    if meta.get("lm"):
        req.add_header("If-Modified-Since", meta["lm"])
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            body = r.read(50 * 1024 * 1024 + 1)
            if len(body) > 50 * 1024 * 1024:
                return url, {"err": "too big"}, None
            if b"BEGIN:VCALENDAR" not in body[:4096].upper() and b"BEGIN:VCALENDAR" not in body.upper():
                return url, {"err": "not an iCalendar file"}, None
            return url, {"etag": r.headers.get("ETag") or "", "lm": r.headers.get("Last-Modified") or ""}, body
    except urllib.error.HTTPError as e:
        if e.code == 304:
            return url, {"etag": meta.get("etag", ""), "lm": meta.get("lm", "")}, None
        return url, {"err": "HTTP %d" % e.code}, None
    except Exception as e:
        return url, {"err": str(getattr(e, "reason", e)) or e.__class__.__name__}, None


def cmd_fetch(args):
    force = "--force" in args or "-f" in args
    now = datetime.now().timestamp()
    urls = feed_urls()
    state = read_state()
    # a copy: changed in place, it would equal state below and never be saved
    feeds = {u: dict(m) for u, m in state.get("feeds", {}).items()}
    changed = False
    due = [u for u in urls if force or now - feeds.get(u, {}).get("t", 0) >= 1800]
    if due:
        from concurrent.futures import ThreadPoolExecutor
        with ThreadPoolExecutor(max_workers=min(8, len(due))) as ex:
            results = list(ex.map(lambda u: fetch_one(u, feeds.get(u, {})), due))
        for url, meta, body in results:
            meta["t"] = now
            if body is not None:
                path = feed_path(url)
                try:
                    with open(path, "rb") as f:
                        same = f.read() == body
                except OSError:
                    same = False
                if not same:
                    atomic_write(path, body)
                    changed = True
            feeds[url] = meta
    keep = {os.path.basename(feed_path(u)) for u in urls}
    try:
        for n in os.listdir(CACHE):
            if n.startswith("feed-") and n.endswith(".ics") and n not in keep:
                os.unlink(os.path.join(CACHE, n))
                changed = True
    except OSError:
        pass
    feeds = {u: m for u, m in feeds.items() if u in urls}
    try:
        st = os.stat(ICS)
        sig = [st.st_mtime_ns, st.st_size, st.st_ino]
    except OSError:
        sig = None
    if state.get("local") != sig and "local" in state:
        changed = True
    new = {"feeds": feeds, "local": sig}
    if new != state:
        os.makedirs(CACHE, exist_ok=True)
        atomic_write(state_path(), json.dumps(new).encode())
    out({"changed": changed, "fetched": len(due), "errors": ["%s: %s" % (u, feeds[u]["err"]) for u in urls if feeds.get(u, {}).get("err")]})


def out(obj):
    sys.stdout.write(json.dumps(obj, ensure_ascii=False, separators=(",", ":")) + "\n")


CMDS = {
    "range": cmd_range, "add": cmd_add, "edit": cmd_edit, "delete": cmd_delete,
    "next-alarm": cmd_next_alarm, "fetch": cmd_fetch,
    "todo": cmd_todo, "todo-edit": cmd_todo_edit,
    "todo-delete": cmd_todo_delete, "todo-done": cmd_todo_done, "routine-done": cmd_routine_done,
    "todo-tidy": cmd_todo_tidy, "routines": cmd_routines,
}


def main(argv):
    if not argv or argv[0] not in CMDS:
        die("usage: cal range [FROM [TO]] | add | edit | delete (JSON on stdin) | next-alarm [AFTER] | fetch [--force] | todo | todo-edit [DAY] [--add] | todo-delete LINE TASK | todo-done LINE TASK | routine-done TASK | todo-tidy | routines", 2)
    CMDS[argv[0]](argv[1:])


if __name__ == "__main__":
