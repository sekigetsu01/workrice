def fold(line):
    b = line.encode()
    if len(b) <= 75:
        return line
    out, cur, n, lim = [], [], 0, 75
    for c in line:
        cl = len(c.encode())
        if n + cl > lim:
            out.append("".join(cur))
            cur, n, lim = [], 0, 74
        cur.append(c)
        n += cl
    out.append("".join(cur))
    return "\r\n ".join(out)


def serialise(comp, out):
    if comp[0]:
        out.append("BEGIN:" + comp[0])
    out.extend(fold(x) for x in comp[1])
    for sub in comp[2]:
        serialise(sub, out)
    if comp[0]:
        out.append("END:" + comp[0])


