            keep.append(line)
    if idx is None:
        idx = len(keep)
    keep[idx:idx] = lines
    comp[1] = keep


def get_prop(comp, name):
    for line in comp[1]:
        if prop_name(line) == name:
            return split_line(line)
    return None


class Raw:
    def __enter__(self):
        import fcntl
        os.makedirs(CACHE, exist_ok=True)
        self.lock = open(os.path.join(CACHE, "write.lock"), "w")
        fcntl.flock(self.lock, fcntl.LOCK_EX)
        try:
            self.root = tree(unfold(read_text(ICS)))
        except FileNotFoundError:
            self.root = ["", [], []]
        cals = [c for c in self.root[2] if c[0] == "VCALENDAR"]
        if not cals:
            cal = ["VCALENDAR", ["VERSION:2.0", "PRODID:-//cal//EN", "CALSCALE:GREGORIAN"], []]
            self.root[2].append(cal)
            cals = [cal]
        self.cal = cals[0]
        self.changed = False
        self.tzs = {}
        for c in self.cal[2]:
            if c[0] == "VTIMEZONE":
                p = get_prop(c, "TZID")
                if p:
                    for sub in c[2]:
                        if sub[0] == "STANDARD":
                            o = get_prop(sub, "TZOFFSETTO")
                            if o:
                                try:
                                    self.tzs[p[2].strip()] = offset(o[2])
                                except ValueError:
                                    pass
        return self

    def __exit__(self, et, ev, tb):
        try:
            if et is None and self.changed:
                lines = []
                serialise(self.root, lines)
                atomic_write(ICS, ("\r\n".join(lines) + "\r\n").encode())
        finally:
            self.lock.close()
        return False

    def tzf(self, tzid):
        return get_tz(tzid, self.tzs)

    def comps(self, kind):
        return [c for cal in calendars(self.root) for c in cal[2] if c[0] == kind]

    def find(self, kind, uid):
        return [c for c in self.comps(kind) if (get_prop(c, "UID") or ("", {}, ""))[2].strip() == uid]

    def remove(self, kind, uids, pred=None):
        n = 0
        for cal in calendars(self.root):
            keep = []
            for c in cal[2]:
                if c[0] == kind and (get_prop(c, "UID") or ("", {}, ""))[2].strip() in uids and (pred is None or pred(c)):
                    n += 1
                else:
                    keep.append(c)
            cal[2] = keep
        self.changed = self.changed or n > 0
        return n

    def add(self, comp):
        self.cal[2].append(comp)
        self.changed = True


