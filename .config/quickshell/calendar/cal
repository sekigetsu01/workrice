def todo_change(args, name, fn):
    if len(args) < 2 or not args[0].isdigit():
        die("usage: cal %s LINE TASK" % name)
    n, task = int(args[0]), args[1]
    text, tasks = plan_read()
    if any(t[0] == n and t[1] == task for t in tasks):
        lines = text.split("\n")
        kind, rest = plan_kind(lines[n])
        if kind == "td":
            parts = [done_split(t) for t in rest.split(",") if t.strip()]
            i = next(i for i, p in enumerate(parts) if p[0] == task)
            parts[i] = fn(parts[i])
            parts = [p for p in parts if p]
            if parts:
                lines[n] = "TD: " + ", ".join(done_join(*p) for p in parts)
            else:
                del lines[n]
        else:
            lead = re.match(r"^\s*(?:[-*+]\s+)?", lines[n]).group(0)
            p = fn(done_split(lines[n][len(lead):]))
            if p:
                lines[n] = lead + done_join(*p)
            else:
                del lines[n]
        atomic_write(ROUTINES, "\n".join(lines).encode("utf-8"))
        text, tasks = plan_read()
    out({"text": text, "now": tasks, "days": {}})


