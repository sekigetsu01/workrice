# gcl NAME…: clone your GitHub repos into ./NAME (replacing it); also user/repo or a URL; git clone options go after the names
_gcl_user() { command head -n1 -- "${XDG_STATE_HOME:-$HOME/.local/state}/ud/usernames" 2>/dev/null; }
gcl() {
	local -a repos failed
	while (( $# )) && [[ $1 != -* ]]; do repos+=("$1"); shift; done
	(( ${#repos} )) || { echo "Usage: gcl repo… [git clone options]   (repo: name, user/repo or url)" >&2; return 1; }
	local src user name dest
	for src in "${repos[@]}"; do
		case $src in
		*://*|git@*) ;;
		*/*) src=https://github.com/$src ;;
		*) user=$(_gcl_user)
		   if [ -z "$user" ]; then
			   read -r "user?Your GitHub username: " || return 1
			   user=${user//[[:space:]]/}
			   [[ $user =~ '^[A-Za-z0-9][A-Za-z0-9-]{0,38}$' ]] || { echo "gcl: a GitHub username is letters, numbers and hyphens" >&2; return 1; }
			   command mkdir -p -- "${XDG_STATE_HOME:-$HOME/.local/state}/ud" &&
				   print -r -- "$user" > "${XDG_STATE_HOME:-$HOME/.local/state}/ud/usernames"
		   fi
		   src=https://github.com/$user/$src ;;
		esac
		name=${${src%/}##*/}; name=${name%.git}; dest=$PWD/$name
		command rm -rf -- "$dest.new"
		if GIT_TERMINAL_PROMPT=0 git clone "$@" -- "$src" "$dest.new"; then
			command rm -rf -- "$dest" && command mv -f -- "$dest.new" "$dest" && print -r -- "${dest/#$HOME/~}"
		else
			command rm -rf -- "$dest.new"; echo "gcl: couldn't clone $src (no such repo, or it's private)" >&2
			failed+=("$name")
		fi
	done
	(( ${#failed} )) && { echo "gcl: not cloned: ${failed[*]}" >&2; return 1; }
	return 0
}

# cat: files shown by bat; with an option, the real cat
cat() {
	[[ $1 == -?* ]] && { command cat "$@"; return; }
	bat --style=numbers,changes,header --color=auto "$@"
}

