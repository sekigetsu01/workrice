# yta URL: audio only, with its cover; yta URL START-END: just that part
yta() {
	case ${2-} in
	[0-9]*-[0-9]*) yt-dlp -x --embed-metadata --embed-thumbnail --convert-thumbnails jpg --exec "after_move:sh -c 'f=\$1 t=\${1%.*}.cut.\${1##*.}; ffmpeg -v error -y -ss \$2 -to \$3 -i \"\$f\" -c copy \"\$t\" && mv -f \"\$t\" \"\$f\"' _ {} ${2%-*} ${2#*-}" "$1" ;;
	*) yt-dlp -x --embed-chapters --embed-metadata --embed-thumbnail --convert-thumbnails jpg --sponsorblock-remove music_offtopic "$@" ;;
	esac
}

# fastfetch, without the logo when the window's too narrow
f() {
	local out
	out=$(fastfetch --pipe false "$@")
	if (( $(print -r -- "$out" | sed $'s/\e\\[[0-9;?]*[a-zA-Z]//g' | wc -L) > COLUMNS )); then
		out=$(fastfetch --pipe false --logo none "$@")
	fi
	print -n '\e[?7l'
	print -r -- "$out"
	print -n '\e[?7h'
}

