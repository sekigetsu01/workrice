for command in mount umount pacman su shutdown poweroff reboot; do
	alias $command="sudo $command"
done; unset command

se() {
	local choice
	choice="$(find ~/.local/bin ~/.config/*/scripts -mindepth 1 -maxdepth 1 -type f 2>/dev/null | sed "s#^$HOME#~#" | fzf)"
	[ -n "$choice" ] && $EDITOR "${choice/#\~/$HOME}"
}

