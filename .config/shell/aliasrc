ls() {
	local arg prev='' eza='' gnu=''
	for arg in "$@"; do
		case "$prev" in
			--time|--time-style) arg=$prev=$arg ;;
		esac
		prev=$arg
		case "$arg" in
			--) break ;;
			--absolute*|--accessed|--across|--binary|--blocksize|--bytes|--changed|--code|--color-scale*|--colour-scale*|\
			--created|--extended|--flags|--follow-symlinks|--git*|--grid|--group|--group-directories-last|\
			--header|--icons*|--ignore-glob*|--level*|--links|--loc|--long|--modified|--mounts|--no-filesize|\
			--no-git|--no-icons|--no-permissions|--no-quotes|--no-symlinks|--no-time|--no-user|--numeric|\
			--octal-permissions|--oneline|--only-dirs|--only-files|--recurse|--short-nix|--show-symlinks|\
			--smart-group|--stdin|--total-size|--treat-dirs-as-files|--tree) eza=1 ;;
			--time-style=relative|--time-style=default|--time=modified|--time=accessed|--time=changed|--time=created) eza=1 ;;
			--sort=version|--sort=width|--time-style=locale|--time-style=posix-*) gnu=1 ;;
			--all|--almost-all|--classify*|--colo*r*|--context|--dereference|--group-directories-first|\
			--help|--hyperlink*|--inode|--reverse|--sort*|--time-style*|--version|--width*) ;;
			--*) gnu=1 ;;
			-*[TD@M]*) eza=1 ;;
			-*[thSXcuUvsmkNQpqLCgofGBHb]*) gnu=1 ;;
		esac
	done
	if [ -n "$gnu" ] && [ -z "$eza" ]; then
		command ls --color=auto "$@"
	else
		eza --icons --group-directories-first "$@"
	fi
}

rm() {
	local arg a r=''
	for arg; do
		shift
		a=${arg%"${arg##*[!/]}"}
		[ -n "$a" ] && [ -L "$a" ] && arg=$a
		[ -d "$arg" ] && [ ! -L "$arg" ] && r=-r
		set -- "$@" "$arg"
	done
	command rm $r -f -v "$@"
}

mkcd() { mkdir -p -- "$1" && cd -- "$1" || return; }


y() {
	local tmp cwd
	tmp=$(mktemp -t yazi-cwd.XXXXXX) || return
	yazi "$@" --cwd-file="$tmp"
	cwd=$(<$tmp)
	command rm -f -- "$tmp"
	[[ $cwd == search://*//* ]] && cwd=/${cwd#search://*//}
	[[ -d $cwd && $cwd != "$PWD" ]] && cd -- "$cwd"
	return 0
}
